{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "title",
    "summary",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
